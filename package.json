{
  "name": "tk4-web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser port of Tapan Kaikki 4 (Bun + custom canvas/WebGL renderer)",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "start": "bun run build && bun run tools/serve.ts",
    "serve": "bun run tools/serve.ts",
    "preview": "bunx --bun vite preview",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "assets": "bun run tools/build-assets.ts",
    "reference": "sh tools/build-reference.sh",
    "parity": "bun run tools/parity.ts",
    "perf": "bun run tools/perf.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
